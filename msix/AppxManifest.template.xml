<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store (MSIX) package for IsleBar. scripts\build-msix.ps1 fills in the {{…}} values:
     Identity Name / Publisher come from Partner Center (Product › Product identity) once the app name is reserved. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>IsleBar</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- No unvirtualizedResources (refused by certification 10-07): the bar and the hook CLI both run with this package's
         identity, so they share the same AppData / HKCU view; the Explorer module lives in %USERPROFILE%\.islebar\tap and the
         supervisor starts the bar so that what it launches runs outside the package (Interop/PackagedChild.cs). -->
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
    <Resource Language="zh-tw" />
    <Resource Language="fr-fr" />
    <Resource Language="de-de" />
    <Resource Language="it-it" />
    <Resource Language="pt-br" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="IsleBar" Executable="IsleBar.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="IsleBar" Description="A live island in the Windows 11 taskbar search box."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- start at sign-in (the person can turn it off in Settings › Apps › Startup) -->
        <desktop:Extension Category="windows.startupTask" Executable="IsleBar.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="IsleBarStartup" Enabled="true" DisplayName="IsleBar" />
        </desktop:Extension>
        <!-- the hook CLI: Claude Code / Codex call "islebar.exe hook" through this alias (%LOCALAPPDATA%\Microsoft\WindowsApps).
             On the main app with its own Executable: a second, hidden app entry (AppListEntry="none") is a "headless app",
             which the Store refuses without a special permission (certification, 10-04). -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="cli\islebar.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="islebar.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
